# Copy to .env.local to override.
#
# Set to exactly "true" to use built-in mock data (no backend needed).
# Anything else — including leaving it out — uses the real FastAPI backend.
VITE_USE_MOCKS=false
#
# Base URL of the FastAPI backend, used only when VITE_USE_MOCKS=false.
#
# Leave EMPTY in dev: the client then calls same-origin "/api/..." and the Vite
# dev proxy forwards to http://localhost:8000, so no CORS is involved.
# Set an absolute URL only to bypass the proxy (e.g. a deployed backend), in
# which case that origin must allow this app's origin via CORS_ORIGINS in
# backend/app/config.py.
VITE_API_BASE_URL=
