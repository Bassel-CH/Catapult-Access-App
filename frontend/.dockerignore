# Build context is frontend/ — these paths are relative to that.

# Reinstalled by `npm ci` inside the image. Copying the host's copy would be
# slow and, worse, wrong: native modules are compiled for the host platform.
node_modules

# Built fresh in stage 1. A stale host dist/ must never be able to leak in.
dist
dist-ssr

# Secrets and machine-local overrides stay out of the build context. Values come
# in as --build-arg instead, so the build is explicit and reproducible.
.env
.env.*
!.env.example
*.local

# Editor / OS noise
.vscode/
.idea/
.DS_Store
*.sw?

# Logs
logs
*.log
npm-debug.log*
