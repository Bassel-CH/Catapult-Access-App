# For backend/Dockerfile, whose build context is backend/. A host .venv must
# stay out: it would hide the packages installed in the image.

.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Real permission data must never enter an image.
**/*.csv

tests/

.pytest_cache/
.mypy_cache/
.ruff_cache/
