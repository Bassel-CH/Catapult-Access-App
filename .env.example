# Copy to .env on the machine that builds or runs production. .env is
# gitignored; docker compose reads it automatically from this folder.

# Version label for the production image, which is built as audit-app:<this>.
# Use the git commit being deployed (`git rev-parse --short HEAD`), so you can
# always tell which code a running container came from. Left empty, builds
# are tagged "local".
IMAGE_TAG=
