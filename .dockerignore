# For the root Dockerfile, whose build context is the whole repo
# (backend/.dockerignore doesn't apply here).
#
# An allowlist: everything is excluded unless let back in below, so a new file
# such as a real CSV or an .env can't reach the image by accident.

*

!backend/requirements.txt
!backend/app/
!frontend/
!deploy/

# Re-exclude noise and secrets inside the allowed folders.
**/__pycache__
**/*.pyc

# Real permission data must never enter the build.
**/*.csv

frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/.env
frontend/.env.*
frontend/*.local
