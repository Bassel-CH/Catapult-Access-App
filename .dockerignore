# Used by the root Dockerfile (combined prod image), whose build context is the
# whole repo. The backend/ and frontend/ .dockerignore files do NOT apply here —
# they only cover builds whose context is that subfolder.
#
# Allowlist: exclude everything, then let back in only what the image needs.
# New files in the repo (real CSVs, scratch exports, .env files) stay out by
# default instead of relying on someone remembering to list them.

*

!backend/requirements.txt
!backend/app/
!frontend/
!deploy/

# Re-exclude noise and secrets inside the allowed folders.
**/__pycache__
**/*.pyc

# Real permissions data must never enter the build.
**/*.csv

frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/*.local
